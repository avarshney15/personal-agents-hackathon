# Copy to backend/.env. Every variable here is read by the code. See SETUP.md, track by track.

# Which modules run for real. SPONSORS_FAKE lists the sponsor modules that stay on their fakes:
#   1 = all four fakes, 0 = all four real, or e.g. "identity,telemetry".
# A module set real without its keys errors when used, so list any module whose keys you lack.
SPONSORS_FAKE=1            # modules: memory, ranking, identity, telemetry
ACT_FAKE=1                 # 1 = simulated RSVPs, 0 = hosted Chrome driven by Claude computer use
FAKE_RSVP_SCENARIO=going   # simulated RSVPs only: going | code | waitlist | paid
FAKE_STEP_SECONDS=1.5

# App
DEMO_USER_NAME=Maya R.
DEMO_USER_EMAIL=           # signing in with this email logs in as the demo user
AUTH_DEV_CODES=1           # Welcome shows the 6-digit code (no email provider)
DATABASE_PATH=./event_agent.db
EVENTS_PATH=               # blank = data/events.json
FRAMES_DIR=                # blank = frames/ next to the database

# Claude: the RSVP agent (computer use), tagging, intent, Ask
ANTHROPIC_API_KEY=
RSVP_MODEL=                # blank = claude-haiku-5-5; claude-opus-5-5 is more reliable on stage
RSVP_EFFORT=medium
RSVP_FALLBACKS=auto
BROWSER=chrome             # chrome = the real Chrome app (sign in by hand); chromium = Playwright's (tests only)
CHROME_PROFILE_DIR=~/.event-agent/chrome   # the agent's own Chrome profile
CHROME_DEBUG_PORT=9222
CHROME_PATH=               # blank = /Applications/Google Chrome.app
BROWSER_PROFILE_DIR=./browser_profile      # BROWSER=chromium only
BROWSER_HEADLESS=1                         # BROWSER=chromium only
TEXT_PROVIDER=             # blank = Claude when ANTHROPIC_API_KEY is set, else keywords; or: arcee | keywords
TEXT_MODEL=

# Cognee (memory). Pick one: Cognee Cloud (both vars) | local cognee with LLM_API_KEY | COGNEE_KEYLESS=1
COGNEE_API_KEY=
COGNEE_SERVICE_URL=
LLM_API_KEY=
COGNEE_KEYLESS=0           # 1 = local models, no key (models already downloaded on this machine)
MEMORY_DB_PATH=./memory.db

# Superlinked SIE (ranking). Without a key, arm "sie" falls back to TF-IDF.
SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com
SIE_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-4B   # empty = skip reranking
SIE_CACHE_PATH=            # blank = data/sie_cache.json

# Persona (verify once), sandbox
PERSONA_API_KEY=           # persona_sandbox_...
PERSONA_INQUIRY_TEMPLATE_ID=   # itmpl_...
PERSONA_WEBHOOK_SECRET=    # only with a public webhook URL; polling works without it
PERSONA_REDIRECT_URI=http://localhost:5173/?verified=1
PERSONA_API_VERSION=2023-01-05

# Amplitude + Statsig (measurement)
AMPLITUDE_API_KEY=
AMPLITUDE_SERVER_ZONE=US
AMPLITUDE_AI_CONTENT_MODE=full     # metadata_only drops message text
STATSIG_SERVER_SECRET=
STATSIG_ENVIRONMENT=       # leave blank: Statsig only counts production data in results

# Calendar: fake (demo "Call with Sam") or airbyte (Google Calendar through PyAirbyte)
CALENDAR_SOURCE=fake
DEMO_CALENDAR_ANCHOR=Agent builders
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=     # scope calendar.readonly
GOOGLE_CALENDAR_ID=primary
AIRBYTE_PYTHON=            # blank = backend/.venv-airbyte/bin/python
CALENDAR_CACHE_SECONDS=300

# Evals and the Ops dashboard
EVAL_API_URL=http://localhost:8000
REHEARSALS_PATH=           # blank = evals/rehearsals.json

# Arcee (stretch; client not written yet, see SETUP.md)
ARCEE_API_KEY=
