# Copy to backend/.env. Leave a sponsor's keys blank to keep it on its fake.
SPONSORS_FAKE=1            # 1 = all fakes, 0 = all real, or a list still on fakes: memory,identity
ACT_FAKE=1                 # 1 = simulated RSVPs, 0 = hosted Chrome + Claude computer use
FAKE_RSVP_SCENARIO=going   # fake RSVPs: going | code | waitlist | paid
DEMO_USER_NAME=Maya R.
AUTH_DEV_CODES=1           # Welcome: show the 6-digit sign-in code (no email provider today)

# Claude: RSVP agent (computer use), tagging, intent, Ask
ANTHROPIC_API_KEY=
RSVP_MODEL=                # blank = the RSVP agent's default
BROWSER_PROFILE_DIR=./browser_profile
BROWSER_HEADLESS=1

# Cognee (memory): Cloud needs both; or LLM_API_KEY for local cognee; or keyless local models
COGNEE_API_KEY=
COGNEE_SERVICE_URL=
LLM_API_KEY=
COGNEE_KEYLESS=0           # 1 = local embedding and extraction models, no key (first run downloads ~820 MB)
MEMORY_DB_PATH=./memory.db

# Superlinked SIE (ranking); without a key, arm "sie" uses TF-IDF
SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com
SIE_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-4B   # empty = skip reranking
SIE_CACHE_PATH=            # blank = data/sie_cache.json

# Text jobs (tagging, intent, Ask parsing): Claude by default; arcee is the stretch seam
TEXT_PROVIDER=anthropic
TEXT_MODEL=

# Persona (verify once), sandbox
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
PERSONA_REDIRECT_URI=http://localhost:5173/?verified=1

# Amplitude + Statsig (measurement)
AMPLITUDE_API_KEY=
STATSIG_SERVER_SECRET=
VITE_STATSIG_CLIENT_KEY=

# Calendar: fake (demo meetings) or airbyte (Google Calendar through PyAirbyte, stretch)
CALENDAR_SOURCE=fake

DATABASE_PATH=./event_agent.db

# Stretch, one only
ARCEE_API_KEY=
SINGLESTORE_URL=
